{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "DepCast conservative upgrade policy — holds major npm bumps for 3 days, labels all unverified upgrades",
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "stabilityDays": 3,
      "labels": ["depcast:unverified"],
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "stabilityDays": 1,
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
